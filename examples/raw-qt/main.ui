<?xml version="1.0" ?>
<ui version="4.0">
 <!--
   Qt Designer form, editable in `designer`.

   Two rules every EZGL form must follow:
     * a QMainWindow named MainWindow, and a QStatusBar named StatusBar
     * a canvas placeholder (see MainCanvas below)
 -->
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>800</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string notr="true">EZGL Example Application</string>
  </property>
  <widget class="QWidget" name="OuterGrid">
   <layout class="QGridLayout" name="OuterGridLayout">
    <property name="leftMargin">
     <number>0</number>
    </property>
    <property name="topMargin">
     <number>0</number>
    </property>
    <property name="rightMargin">
     <number>0</number>
    </property>
    <property name="bottomMargin">
     <number>0</number>
    </property>
    <property name="spacing">
     <number>0</number>
    </property>
    <item row="0" column="0" rowspan="1" colspan="1">
     <!--
       The canvas. A .ui file can only name widget classes that Qt ships, so
       EZGL's drawing area is declared as a plain QWidget carrying the
       ezglWidgetClass tag. ezgl::UiLoader swaps in the real widget when the
       form loads: a DrawingAreaWidget, or an RhiCanvasWidget under the rhi
       renderer. stdset="0" marks it a dynamic property, which is how a form
       carries information Qt itself knows nothing about.
     -->
     <widget class="QWidget" name="MainCanvas">
      <property name="ezglWidgetClass" stdset="0">
       <string>DrawingAreaWidget</string>
      </property>
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
        <horstretch>0</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
     </widget>
    </item>
    <item row="0" column="0" rowspan="1" colspan="1">
     <widget class="QPushButton" name="MyButton">
      <property name="text">
       <string>Hello, World!</string>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
  <!-- Required: application::update_message writes here, and a form must
       declare it explicitly. -->
  <widget class="QStatusBar" name="StatusBar"/>
 </widget>
 <resources/>
 <connections/>
</ui>
